# -----------------------------------------------------------------------------
# AI Dev Hub - Environment Variables Template
# Copy this file to .env and fill in your own API keys:
# cp config/.env.example config/.env
# -----------------------------------------------------------------------------

# Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=""

# OpenRouter Unified API Key (Get key for DeepSeek, Kimi, Claude, GPT-4o at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# DeepSeek Official API Key (Get key at: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=""

# Moonshot AI (Kimi) Official API Key (Get key at: https://platform.moonshot.cn/console/api-keys)
MOONSHOT_API_KEY=""

# Local Models GGUF Directory (Default: ~/models or /storage/emulated/0/LLM's)
LOCAL_MODELS_PATH="/storage/emulated/0/LLM's"
