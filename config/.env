# -----------------------------------------------------------------------------
# AI Dev Hub - Environment Variables Template
# Copy this file to .env and fill in your own API keys:
# cp config/.env.example config/.env
# -----------------------------------------------------------------------------

# Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=""

# OpenRouter Unified API Key (Get key for DeepSeek, Kimi, Claude, GPT-4o at: https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# DeepSeek Official API Key (Get key at: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=""

# Moonshot AI (Kimi) Official API Key (Get key at: https://platform.moonshot.cn/console/api-keys)
MOONSHOT_API_KEY=""

# Local Models GGUF Directory (Default: ~/models or ./models)
# Optional: On Android/Termux with shared storage you can set it to /storage/emulated/0/LLM's
LOCAL_MODELS_PATH="~/models"

# OpenSandbox Server Configuration (Optional: for isolated code execution & agent loops)
# If left as localhost:8080 or unconfigured, the system automatically uses the secure Local Fallback Sandbox.
OPENSANDBOX_ENDPOINT="http://localhost:8080"
OPENSANDBOX_API_KEY=""
OPENSANDBOX_TIMEOUT="45"
